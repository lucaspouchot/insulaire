{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Insulaire",
  "version": "0.21.1",
  "identifier": "com.insulaire.game",
  "build": {
    "frontendDist": "../web/dist/web/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": {
      "cwd": "../..",
      "script": "npm run start --workspace web"
    },
    "beforeBuildCommand": {
      "cwd": "../..",
      "script": "npm run build:deliver --workspace web"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Insulaire",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Authored hexagonal world, turn-based.",
    "longDescription": "A turn-based game on an authored hexagonal world: Angular and Canvas for the interface, a deterministic Rust simulation compiled to WebAssembly for the rules.",
    "copyright": "GNU GPL v3",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "games"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
