{
  "id": "new_game",
  "schemaVersion": 1,
  "baseCharacter": "human_player",
  "choices": [
    {
      "id": "lineage",
      "labelKey": "game.creation.lineage",
      "helpKey": "game.creation.lineageHelp",
      "control": "select",
      "default": "human",
      "options": [
        { "value": "human", "labelKey": "game.creation.lineageHuman" },
        { "value": "elf", "labelKey": "game.creation.lineageElf" }
      ],
      "binding": { "kind": "parameter", "parameter": "lineage" }
    },
    {
      "id": "gender",
      "labelKey": "game.creation.gender",
      "control": "select",
      "default": "woman",
      "options": [
        { "value": "woman", "labelKey": "game.creation.genderWoman" },
        { "value": "man", "labelKey": "game.creation.genderMan" }
      ],
      "binding": { "kind": "parameter", "parameter": "gender" }
    },
    {
      "id": "hairStyle",
      "labelKey": "game.character.hairStyle",
      "control": "select",
      "default": "short",
      "options": [
        { "value": "short", "labelKey": "game.character.hairShort" },
        { "value": "long", "labelKey": "game.character.hairLong" }
      ],
      "binding": { "kind": "parameter", "parameter": "hairStyle" }
    },
    {
      "id": "eyeColor",
      "labelKey": "game.creation.eyeColor",
      "control": "color",
      "default": "#4f7cac",
      "binding": { "kind": "parameter", "parameter": "eyeColor" }
    },
    {
      "id": "height",
      "labelKey": "game.creation.height",
      "control": "slider",
      "default": 170,
      "min": 140,
      "max": 210,
      "step": 1,
      "unit": "cm",
      "binding": { "kind": "parameter", "parameter": "height" }
    },
    {
      "id": "bust",
      "labelKey": "game.creation.bust",
      "control": "slider",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "binding": { "kind": "parameter", "parameter": "bust" }
    }
  ],
  "characteristics": [
    { "id": "name", "labelKey": "game.creation.name", "control": "text", "default": "", "nullable": false },
    { "id": "age", "labelKey": "game.creation.age", "control": "number", "default": 18, "min": 0, "step": 1, "nullable": false },
    { "id": "hp", "labelKey": "game.creation.hp", "control": "number", "default": 100, "min": 0, "max": 100, "nullable": false },
    { "id": "mana", "labelKey": "game.creation.mana", "control": "number", "default": null, "min": 0, "nullable": true },
    { "id": "endurance", "labelKey": "game.creation.endurance", "control": "number", "default": 10, "min": 0, "nullable": false },
    { "id": "agility", "labelKey": "game.creation.agility", "control": "number", "default": 10, "min": 0, "max": 100, "nullable": false },
    { "id": "experience", "labelKey": "game.creation.experience", "control": "number", "default": 0, "min": 0, "nullable": false },
    { "id": "corruption", "labelKey": "game.creation.corruption", "control": "number", "default": 0, "min": 0, "max": 100, "nullable": false },
    { "id": "libido", "labelKey": "game.creation.libido", "control": "number", "default": 50, "min": 0, "max": 100, "nullable": false }
  ],
  "screens": [
    {
      "id": "identity",
      "titleKey": "game.creation.identityTitle",
      "textKey": "game.creation.identityText",
      "transition": "fade",
      "blocks": [
        { "type": "choice", "choice": "lineage" },
        { "type": "choice", "choice": "gender" },
        { "type": "characteristic", "characteristic": "name" },
        { "type": "characteristic", "characteristic": "age" },
        { "type": "preview", "animation": "idle" }
      ]
    },
    {
      "id": "appearance",
      "titleKey": "game.creation.appearanceTitle",
      "textKey": "game.creation.appearanceText",
      "transition": "slideLeft",
      "blocks": [
        { "type": "choice", "choice": "hairStyle" },
        { "type": "choice", "choice": "eyeColor" },
        { "type": "choice", "choice": "height" },
        { "type": "choice", "choice": "bust" },
        { "type": "preview", "animation": "idle" }
      ]
    },
    {
      "id": "attributes",
      "titleKey": "game.creation.attributesTitle",
      "textKey": "game.creation.attributesText",
      "transition": "slideLeft",
      "blocks": [
        { "type": "preview", "animation": "idle", "parameters": { "armor": "plate", "cape": true } },
        { "type": "characteristic", "characteristic": "hp" },
        { "type": "characteristic", "characteristic": "mana" },
        { "type": "characteristic", "characteristic": "endurance" },
        { "type": "characteristic", "characteristic": "agility" },
        { "type": "characteristic", "characteristic": "experience" },
        { "type": "characteristic", "characteristic": "corruption" },
        { "type": "characteristic", "characteristic": "libido" },
        { "type": "summary" }
      ]
    }
  ]
}
