{
  "id": "human_player",
  "schemaVersion": 2,
  "name": "Human Player",
  "category": "player",
  "resolution": { "width": 64, "height": 128 },
  "parameters": [
    {
      "id": "hairStyle",
      "labelKey": "game.character.hairStyle",
      "control": "select",
      "default": "long",
      "options": [
        { "value": "long", "labelKey": "game.character.hairLong" },
        { "value": "short", "labelKey": "game.character.hairShort" }
      ]
    },
    {
      "id": "hairColor",
      "labelKey": "game.character.hairColor",
      "control": "color",
      "default": "#8b5a2b"
    },
    {
      "id": "armor",
      "labelKey": "game.character.armor",
      "helpKey": "game.character.armorHelp",
      "control": "select",
      "default": "leather",
      "options": [
        { "value": "leather", "labelKey": "game.character.armorLeather" },
        { "value": "plate", "labelKey": "game.character.armorPlate" }
      ]
    },
    {
      "id": "cape",
      "labelKey": "game.character.cape",
      "control": "toggle",
      "default": true
    }
  ],
  "layers": [
    {
      "id": "cape",
      "variants": [
        { "id": "worn", "when": { "cape": true }, "rect": [12, 27, 40, 95], "sprite": { "asset": "assets/characters/cape.png" } }
      ]
    },
    {
      "id": "hairBack",
      "variants": [
        { "id": "long", "when": { "hairStyle": "long" }, "rect": [20, 17, 24, 48], "sprite": { "asset": "assets/characters/hair_back.png", "tint": { "parameter": "hairColor" } } }
      ]
    },
    {
      "id": "body",
      "variants": [
        { "id": "default", "rect": [21, 12, 22, 107], "sprite": { "asset": "assets/characters/body.png" } }
      ]
    },
    {
      "id": "boots",
      "variants": [
        { "id": "default", "rect": [23, 101, 18, 22], "sprite": { "asset": "assets/characters/boots.png" } }
      ]
    },
    {
      "id": "top",
      "variants": [
        { "id": "plate", "when": { "armor": "plate" }, "rect": [23, 36, 18, 14], "sprite": { "asset": "assets/characters/top_plate.png" } },
        { "id": "leather", "rect": [23, 36, 18, 14], "sprite": { "asset": "assets/characters/top_leather.png" } }
      ]
    },
    {
      "id": "skirt",
      "variants": [
        { "id": "default", "rect": [19, 59, 26, 22], "sprite": { "asset": "assets/characters/skirt.png" } }
      ]
    },
    {
      "id": "hairFront",
      "variants": [
        { "id": "default", "rect": [23, 10, 18, 20], "sprite": { "asset": "assets/characters/hair_front.png", "tint": { "parameter": "hairColor" } } }
      ]
    }
  ]
}
